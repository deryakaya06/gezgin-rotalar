rules_version = '2';

// Proje Spark (ücretsiz) planında, Cloud Functions yok. Puan ve sayaç güncellemelerini
// istemci tek bir batch içinde yapar; kurallar getAfter/existsAfter ile batch'in
// tutarlı olduğunu doğrular (ör. puan artışı gerçekten yeni oluşturulan bir check-in'e ait).
// Takipçi/takip sayıları alan olarak tutulmaz, count() sorgusuyla hesaplanır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function checkInPath(id) {
      return /databases/$(database)/documents/check_ins/$(id);
    }

    function locationPath(id) {
      return /databases/$(database)/documents/locations/$(id);
    }

    function followingPath(uid, targetId) {
      return /databases/$(database)/documents/users/$(uid)/following/$(targetId);
    }

    function followerPath(uid, followerId) {
      return /databases/$(database)/documents/users/$(uid)/followers/$(followerId);
    }

    function visitPath(uid, locationId) {
      return /databases/$(database)/documents/users/$(uid)/visits/$(locationId);
    }

    // packages/shared/src/constants.ts ile aynı olmalı.
    function pointsPerCheckIn() {
      return 10;
    }

    // packages/shared/src/constants.ts içindeki CLOUDINARY.cloudName ile aynı olmalı.
    function cloudinaryCloudName() {
      return 'lgk3ljrv';
    }

    function validPhotoUrl(url) {
      return url is string
        && url.size() <= 300
        && url.matches('https://res[.]cloudinary[.]com/' + cloudinaryCloudName() + '/image/upload/.+');
    }

    function duplicateWindow() {
      return duration.value(24, 'h');
    }

    // role alanını yalnızca Firebase Console'dan (kuralları atlayarak) eklemek mümkündür;
    // kullanıcı kendi profiline role yazamaz (create/update kuralları buna izin vermez).
    function isAdmin() {
      return signedIn() && get(userPath(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function validLocation(data) {
      return data.keys().hasOnly([
          'name', 'description', 'district', 'category', 'coordinates', 'rating',
          'isFree', 'isSponsored', 'sponsorInfo', 'createdAt', 'updatedAt',
          'coverPhotoUrl', 'coverPhotoCredit', 'coverPhotoSource'
        ])
        && (!('coverPhotoUrl' in data) || validPhotoUrl(data.coverPhotoUrl))
        && data.get('coverPhotoCredit', '') is string && data.get('coverPhotoCredit', '').size() <= 200
        && data.get('coverPhotoSource', '') is string && data.get('coverPhotoSource', '').size() <= 500
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.get('district', '') is string
        && data.get('category', '') is string
        && (!('coordinates' in data) || (
          data.coordinates.keys().hasOnly(['latitude', 'longitude'])
          && data.coordinates.latitude is number && data.coordinates.latitude >= -90 && data.coordinates.latitude <= 90
          && data.coordinates.longitude is number && data.coordinates.longitude >= -180 && data.coordinates.longitude <= 180
        ))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && data.get('isFree', false) is bool
        && data.get('isSponsored', false) is bool
        && (data.get('sponsorInfo', null) == null || data.sponsorInfo.name is string);
    }

    function validProfileFields(data) {
      return data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.accountType in ['couple', 'friends'];
    }

    // Bu batch'te oluşturulan check-in'e karşılık gelen puan/ziyaret artışı.
    function isCheckInCounterUpdate(uid) {
      let after = request.resource.data;
      let id = after.lastCheckInId;
      let checkIn = getAfter(checkInPath(id)).data;
      return after.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'visitCount', 'lastCheckInId'])
        && id is string
        && !exists(checkInPath(id))
        && existsAfter(checkInPath(id))
        && checkIn.userId == uid
        && after.totalPoints == resource.data.totalPoints + checkIn.points
        && after.visitCount == resource.data.visitCount + 1;
    }

    // Eski şemadaki (points, email) profili bir kereye mahsus yeni şemaya taşıma.
    // Eski sürümde her check-in 10 puan verdiği için ziyaret sayısı puandan çıkarılır.
    function isLegacyMigration() {
      let after = request.resource.data;
      let legacyPoints = resource.data.get('points', 0);
      return !('totalPoints' in resource.data)
        && after.keys().hasOnly(['displayName', 'accountType', 'totalPoints', 'visitCount', 'createdAt'])
        && validProfileFields(after)
        && after.totalPoints == legacyPoints
        && after.visitCount == math.floor(legacyPoints / pointsPerCheckIn());
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'accountType', 'totalPoints', 'visitCount', 'createdAt'
        ])
        && validProfileFields(request.resource.data)
        && request.resource.data.totalPoints == 0
        && request.resource.data.visitCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'accountType'])
          && validProfileFields(request.resource.data)
        )
        || isCheckInCounterUpdate(uid)
        || isLegacyMigration()
      );

      allow delete: if false;

      // Takip ilişkisi iki tarafta tutulur ve ikisi aynı batch'te yazılır/silinir:
      //   users/{me}/following/{target}  +  users/{target}/followers/{me}
      match /following/{targetId} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && targetId != uid
          && exists(userPath(targetId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(followerPath(targetId, uid));
        allow delete: if isOwner(uid)
          && !existsAfter(followerPath(targetId, uid));
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create: if isOwner(followerId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(followingPath(followerId, uid));
        allow delete: if isOwner(followerId)
          && !existsAfter(followingPath(followerId, uid));
      }

      // Mekan başına son puan alınan zaman; 24 saat kuralını uygulamak için.
      match /visits/{locationId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['lastAwardedAt', 'checkInId'])
          && request.resource.data.lastAwardedAt == request.time
          && (resource == null || resource.data.lastAwardedAt <= request.time - duplicateWindow())
          && !exists(checkInPath(request.resource.data.checkInId))
          && getAfter(checkInPath(request.resource.data.checkInId)).data.userId == uid
          && getAfter(checkInPath(request.resource.data.checkInId)).data.locationId == locationId
          && getAfter(checkInPath(request.resource.data.checkInId)).data.points == pointsPerCheckIn();
        allow delete: if false;
      }
    }

    // Mekanları yalnızca admin yazar (şimdilik scripts/seed-locations.mjs, Sprint 5'te admin paneli).
    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validLocation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /check_ins/{checkInId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'locationId', 'locationName', 'note', 'points', 'createdAt', 'photoUrl'
        ])
        && (!('photoUrl' in request.resource.data) || validPhotoUrl(request.resource.data.photoUrl))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(locationPath(request.resource.data.locationId))
        && request.resource.data.locationName
             == get(locationPath(request.resource.data.locationId)).data.name
        // Puan ya 0'dır ya da bu batch'te mekanın visits kaydı güncellenmiştir
        // (visits kuralı 24 saat sınırını uygular).
        && (
          request.resource.data.points == 0
          || (
            request.resource.data.points == pointsPerCheckIn()
            && getAfter(visitPath(request.auth.uid, request.resource.data.locationId)).data.checkInId == checkInId
          )
        )
        // Kullanıcının puan/ziyaret sayacı aynı batch'te artırılmalıdır.
        && getAfter(userPath(request.auth.uid)).data.lastCheckInId == checkInId;

      // Silme puanı geri almayı gerektirir; moderasyon admin panelinden yapılacak.
      allow update, delete: if false;
    }
  }
}
