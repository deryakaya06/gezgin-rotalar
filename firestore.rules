rules_version = '2';

// Proje Spark (ücretsiz) planında, Cloud Functions yok. Puan ve sayaç güncellemelerini
// istemci tek bir batch içinde yapar; kurallar getAfter/existsAfter ile batch'in
// tutarlı olduğunu doğrular (ör. puan artışı gerçekten yeni oluşturulan bir check-in'e ait).
// Takipçi/takip sayıları alan olarak tutulmaz, count() sorgusuyla hesaplanır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function checkInPath(id) {
      return /databases/$(database)/documents/check_ins/$(id);
    }

    function locationPath(id) {
      return /databases/$(database)/documents/locations/$(id);
    }

    function followingPath(uid, targetId) {
      return /databases/$(database)/documents/users/$(uid)/following/$(targetId);
    }

    function followerPath(uid, followerId) {
      return /databases/$(database)/documents/users/$(uid)/followers/$(followerId);
    }

    function blockedPath(uid, targetId) {
      return /databases/$(database)/documents/users/$(uid)/blocked/$(targetId);
    }

    // Bildirimi yazan kişi kendisidir, adı profilindekiyle aynıdır ve okunmamış başlar.
    function validNotification() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'actorId', 'actorName', 'targetId', 'targetName', 'read', 'createdAt'])
        && data.keys().hasAll(['type', 'actorId', 'actorName', 'targetId', 'targetName', 'read', 'createdAt'])
        && data.actorId == request.auth.uid
        && data.actorName == get(userPath(request.auth.uid)).data.displayName
        && data.targetId is string
        && data.targetName is string
        && data.targetName.size() <= 120
        && data.read == false
        && data.createdAt == request.time;
    }

    // Aynı batch'te gerçekten takip edilmiş olmalı.
    function isFollowNotification(uid, notificationId) {
      let data = request.resource.data;
      return data.type == 'follow'
        && notificationId == 'follow_' + request.auth.uid
        && data.targetId == ''
        && data.targetName == ''
        && existsAfter(followingPath(request.auth.uid, uid));
    }

    // Aynı batch'te oluşturulan check-in'de etiketlenmiş ve takip edilen biri olmalı.
    // Engelleme iki yöndeki takibi kaldırdığı için takip şartı engeli de kapsar.
    function isTagNotification(uid, notificationId) {
      let data = request.resource.data;
      let checkIn = getAfter(checkInPath(data.targetId)).data;
      return data.type == 'tag'
        && notificationId == 'tag_' + data.targetId
        && uid != request.auth.uid
        && !exists(checkInPath(data.targetId))
        && checkIn.userId == request.auth.uid
        && uid in checkIn.get('taggedUserIds', [])
        && checkIn.locationName == data.targetName
        && exists(followingPath(request.auth.uid, uid));
    }

    // Admin, bekleyen öneriyi aynı batch'te onaylayıp reddederken sahibine haber verir.
    function isSuggestionNotification(uid, notificationId) {
      let data = request.resource.data;
      let after = getAfter(suggestionPath(data.targetId)).data;
      return isAdmin()
        && data.type in ['suggestion_approved', 'suggestion_rejected']
        && notificationId == 'suggestion_' + data.targetId
        && get(suggestionPath(data.targetId)).data.status == 'pending'
        && after.userId == uid
        && after.name == data.targetName
        && after.status == (data.type == 'suggestion_approved' ? 'approved' : 'rejected');
    }

    function likePath(checkInId, uid) {
      return /databases/$(database)/documents/check_ins/$(checkInId)/likes/$(uid);
    }

    function suggestionPath(id) {
      return /databases/$(database)/documents/suggested_locations/$(id);
    }

    function suggestionVotePath(id, uid) {
      return /databases/$(database)/documents/suggested_locations/$(id)/votes/$(uid);
    }

    function visitPath(uid, locationId) {
      return /databases/$(database)/documents/users/$(uid)/visits/$(locationId);
    }

    // packages/shared/src/constants.ts ile aynı olmalı.
    function pointsPerCheckIn() {
      return 10;
    }

    // packages/shared/src/constants.ts içindeki CLOUDINARY.cloudName ile aynı olmalı.
    function cloudinaryCloudName() {
      return 'lgk3ljrv';
    }

    function validPhotoUrl(url) {
      return url is string
        && url.size() <= 300
        && url.matches('https://res[.]cloudinary[.]com/' + cloudinaryCloudName() + '/image/upload/.+');
    }

    function duplicateWindow() {
      return duration.value(24, 'h');
    }

    // role alanını yalnızca Firebase Console'dan (kuralları atlayarak) eklemek mümkündür;
    // kullanıcı kendi profiline role yazamaz (create/update kuralları buna izin vermez).
    function isAdmin() {
      return signedIn() && get(userPath(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function validLocation(data) {
      return data.keys().hasOnly([
          'name', 'description', 'district', 'category', 'coordinates', 'rating',
          'isFree', 'isSponsored', 'sponsorInfo', 'createdAt', 'updatedAt',
          'coverPhotoUrl', 'coverPhotoCredit', 'coverPhotoSource'
        ])
        && (!('coverPhotoUrl' in data) || validPhotoUrl(data.coverPhotoUrl))
        && data.get('coverPhotoCredit', '') is string && data.get('coverPhotoCredit', '').size() <= 200
        && data.get('coverPhotoSource', '') is string && data.get('coverPhotoSource', '').size() <= 500
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.get('district', '') is string
        && data.get('category', '') is string
        && (!('coordinates' in data) || (
          data.coordinates.keys().hasOnly(['latitude', 'longitude'])
          && data.coordinates.latitude is number && data.coordinates.latitude >= -90 && data.coordinates.latitude <= 90
          && data.coordinates.longitude is number && data.coordinates.longitude >= -180 && data.coordinates.longitude <= 180
        ))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && data.get('isFree', false) is bool
        && data.get('isSponsored', false) is bool
        && (data.get('sponsorInfo', null) == null || data.sponsorInfo.name is string);
    }

    function validProfileFields(data) {
      return data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.accountType in ['couple', 'friends']
        && validSearchName(data)
        && (!('photoUrl' in data) || validPhotoUrl(data.photoUrl));
    }

    // Kullanıcı aramasında kullanılan sadeleştirilmiş ad (packages/shared searchKey).
    function validSearchName(data) {
      return !('searchName' in data)
        || (data.searchName is string && data.searchName.size() <= 60);
    }

    // Bu batch'te oluşturulan check-in'e karşılık gelen puan/ziyaret artışı.
    function isCheckInCounterUpdate(uid) {
      let after = request.resource.data;
      let id = after.lastCheckInId;
      let checkIn = getAfter(checkInPath(id)).data;
      return after.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'visitCount', 'lastCheckInId'])
        && id is string
        && !exists(checkInPath(id))
        && existsAfter(checkInPath(id))
        && checkIn.userId == uid
        && after.totalPoints == resource.data.totalPoints + checkIn.points
        && after.visitCount == resource.data.visitCount + 1;
    }

    // Bu batch'te silinen kendi check-in'inin puanı ve ziyareti geri alınır.
    function isCheckInDeletionUpdate(uid) {
      let after = request.resource.data;
      let id = after.lastDeletedCheckInId;
      let checkIn = get(checkInPath(id)).data;
      return after.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'visitCount', 'lastDeletedCheckInId'])
        && id is string
        && exists(checkInPath(id))
        && !existsAfter(checkInPath(id))
        && checkIn.userId == uid
        && after.totalPoints == resource.data.totalPoints - checkIn.get('points', 0)
        && after.visitCount == resource.data.visitCount - 1;
    }

    // Eski şemadaki (points, email) profili bir kereye mahsus yeni şemaya taşıma.
    // Eski sürümde her check-in 10 puan verdiği için ziyaret sayısı puandan çıkarılır.
    function isLegacyMigration() {
      let after = request.resource.data;
      let legacyPoints = resource.data.get('points', 0);
      return !('totalPoints' in resource.data)
        && after.keys().hasOnly(['displayName', 'accountType', 'totalPoints', 'visitCount', 'createdAt', 'searchName'])
        && validProfileFields(after)
        && after.totalPoints == legacyPoints
        && after.visitCount == math.floor(legacyPoints / pointsPerCheckIn());
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'accountType', 'totalPoints', 'visitCount', 'createdAt', 'searchName'
        ])
        && validProfileFields(request.resource.data)
        && request.resource.data.totalPoints == 0
        && request.resource.data.visitCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'accountType', 'searchName', 'photoUrl'])
          && validProfileFields(request.resource.data)
        )
        || isCheckInCounterUpdate(uid)
        || isCheckInDeletionUpdate(uid)
        || isLegacyMigration()
      )
      // Admin, arama alanı eksik eski hesapları doldurabilir (scripts/backfill-search-names.mjs).
      || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['searchName'])
        && validSearchName(request.resource.data)
      )
      // Admin, şikâyet edilen check-in'i kaldırırken sahibinin puanını geri alır.
      || (isAdmin() && isCheckInDeletionUpdate(uid));

      allow delete: if false;

      // Takip ilişkisi iki tarafta tutulur ve ikisi aynı batch'te yazılır/silinir:
      //   users/{me}/following/{target}  +  users/{target}/followers/{me}
      match /following/{targetId} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && targetId != uid
          && exists(userPath(targetId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(followerPath(targetId, uid))
          // Engellenen kişi engelleyeni takip edemez; engelleyen de önce engeli kaldırmalıdır.
          && !exists(blockedPath(targetId, uid))
          && !exists(blockedPath(uid, targetId));
        // Takibi bırakan ya da takipçisini çıkaran (engelleme) taraf silebilir.
        allow delete: if (isOwner(uid) || isOwner(targetId))
          && !existsAfter(followerPath(targetId, uid));
      }

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create: if isOwner(followerId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(followingPath(followerId, uid));
        allow delete: if (isOwner(followerId) || isOwner(uid))
          && !existsAfter(followingPath(followerId, uid));
      }

      // Bildirimleri yalnızca sahibi okur ve okundu yapar. Takibi bırakan kişi kendi
      // takip bildirimini geri alabilir (belge id'si kimin yazdığını gösterir).
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if signedIn()
          && validNotification()
          && (
            isFollowNotification(uid, notificationId)
            || isTagNotification(uid, notificationId)
            || isSuggestionNotification(uid, notificationId)
          );
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if isOwner(uid)
          || (signedIn() && notificationId == 'follow_' + request.auth.uid);
      }

      // Duyuruların en son ne zaman görüldüğü (okunmamış sayısı için).
      match /notification_state/{stateId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && stateId == 'announcements'
          && request.resource.data.keys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
      }

      // Engellenenler listesi özeldir; karşı taraf engellendiğini göremez.
      match /blocked/{targetId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && targetId != uid
          && exists(userPath(targetId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Mekan başına son puan alınan zaman; 24 saat kuralını uygulamak için.
      match /visits/{locationId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['lastAwardedAt', 'checkInId'])
          && request.resource.data.lastAwardedAt == request.time
          && (resource == null || resource.data.lastAwardedAt <= request.time - duplicateWindow())
          && !exists(checkInPath(request.resource.data.checkInId))
          && getAfter(checkInPath(request.resource.data.checkInId)).data.userId == uid
          && getAfter(checkInPath(request.resource.data.checkInId)).data.locationId == locationId
          && getAfter(checkInPath(request.resource.data.checkInId)).data.points == pointsPerCheckIn();
        allow delete: if false;
      }
    }

    // Mekanları yalnızca admin yazar (şimdilik scripts/seed-locations.mjs, Sprint 5'te admin paneli).
    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validLocation(request.resource.data);
      allow delete: if isAdmin();
    }

    // Mekan önerileri herkese açıktır. Oy sayacı yalnızca ±1 ve aynı batch'te isteği
    // yapanın oy kaydı eklenip silinerek değişir; kişi kendi önerisine oy veremez.
    match /suggested_locations/{suggestionId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'name', 'district', 'category', 'description',
          'status', 'voteCount', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'name', 'district', 'category', 'description',
          'status', 'voteCount', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.district is string
        && request.resource.data.district.size() >= 2
        && request.resource.data.district.size() <= 40
        // packages/shared/src/constants.ts LOCATION_CATEGORIES ile aynı olmalı.
        && request.resource.data.category in ['Tarihi', 'Müze', 'Park', 'Manzara', 'Çarşı', 'Sokak', 'Ada', 'Lezzet']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.voteCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
        && (
          (
            request.resource.data.voteCount == resource.data.voteCount + 1
            && !exists(suggestionVotePath(suggestionId, request.auth.uid))
            && existsAfter(suggestionVotePath(suggestionId, request.auth.uid))
          )
          || (
            request.resource.data.voteCount == resource.data.voteCount - 1
            && exists(suggestionVotePath(suggestionId, request.auth.uid))
            && !existsAfter(suggestionVotePath(suggestionId, request.auth.uid))
          )
        );

      // Admin bekleyen öneriyi onaylar ya da reddeder.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending';

      match /votes/{voterId} {
        allow read: if signedIn();
        allow create: if isOwner(voterId)
          && get(suggestionPath(suggestionId)).data.userId != voterId
          && get(suggestionPath(suggestionId)).data.status == 'pending'
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(suggestionPath(suggestionId)).data.voteCount
               == get(suggestionPath(suggestionId)).data.voteCount + 1;
        allow delete: if isOwner(voterId)
          && getAfter(suggestionPath(suggestionId)).data.voteCount
               == get(suggestionPath(suggestionId)).data.voteCount - 1;
      }
    }

    // Sponsorlu mekan duyuruları: herkes okur, yalnızca admin yazar.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'locationId', 'locationName', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'body', 'locationId', 'locationName', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 300
        && request.resource.data.locationId is string
        && get(locationPath(request.resource.data.locationId)).data.get('isSponsored', false) == true
        && request.resource.data.locationName == get(locationPath(request.resource.data.locationId)).data.name
        && request.resource.data.createdAt == request.time;
    }

    // Gezi planları özeldir; yalnızca sahibi görür, oluşturur ve siler.
    match /planned_trips/{tripId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'date', 'locationIds', 'locationNames', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'title', 'date', 'locationIds', 'locationNames', 'note', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.locationIds is list
        && request.resource.data.locationIds.size() >= 1
        && request.resource.data.locationIds.size() <= 10
        && request.resource.data.locationNames is list
        && request.resource.data.locationNames.size() == request.resource.data.locationIds.size()
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    // Kişi bir paylaşımı bir kez şikâyet eder (id: checkInId_uid); şikâyetleri yalnızca admin görür.
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'checkInId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterId', 'checkInId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.checkInId is string
        && reportId == request.resource.data.checkInId + '_' + request.auth.uid
        && request.resource.data.reason in ['spam', 'inappropriate', 'fake', 'other']
        && request.resource.data.createdAt == request.time
        && exists(checkInPath(request.resource.data.checkInId))
        && get(checkInPath(request.resource.data.checkInId)).data.userId != request.auth.uid;
    }

    match /check_ins/{checkInId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'locationId', 'locationName', 'note', 'points', 'createdAt', 'photoUrl',
          'taggedUserIds'
        ])
        // packages/shared/src/constants.ts MAX_CHECKIN_TAGS ile aynı olmalı.
        && request.resource.data.get('taggedUserIds', []) is list
        && request.resource.data.get('taggedUserIds', []).size() <= 5
        && (!('photoUrl' in request.resource.data) || validPhotoUrl(request.resource.data.photoUrl))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(locationPath(request.resource.data.locationId))
        && request.resource.data.locationName
             == get(locationPath(request.resource.data.locationId)).data.name
        // Puan ya 0'dır ya da bu batch'te mekanın visits kaydı güncellenmiştir
        // (visits kuralı 24 saat sınırını uygular).
        && (
          request.resource.data.points == 0
          || (
            request.resource.data.points == pointsPerCheckIn()
            && getAfter(visitPath(request.auth.uid, request.resource.data.locationId)).data.checkInId == checkInId
          )
        )
        // Kullanıcının puan/ziyaret sayacı aynı batch'te artırılmalıdır.
        && getAfter(userPath(request.auth.uid)).data.lastCheckInId == checkInId;

      // Tek izin verilen değişiklik beğeni sayacı: yalnızca ±1 ve aynı batch'te
      // isteği yapanın beğeni kaydı eklenmiş/silinmiş olmalı.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (
            request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            && !exists(likePath(checkInId, request.auth.uid))
            && existsAfter(likePath(checkInId, request.auth.uid))
          )
          || (
            request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            && exists(likePath(checkInId, request.auth.uid))
            && !existsAfter(likePath(checkInId, request.auth.uid))
          )
        );

      // Sahibi veya admin silebilir; aynı batch'te sahibinin puanı ve ziyaret sayısı
      // geri alınmalıdır (users kuralındaki isCheckInDeletionUpdate).
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && getAfter(userPath(resource.data.userId)).data.get('lastDeletedCheckInId', '') == checkInId;

      // check_ins/{id}/likes/{uid}: kullanıcı yalnızca kendi beğenisini ekler/siler;
      // sayaç aynı batch'te güncellenmelidir.
      match /likes/{likerId} {
        allow read: if signedIn();
        allow create: if isOwner(likerId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(checkInPath(checkInId)).data.likeCount
               == get(checkInPath(checkInId)).data.get('likeCount', 0) + 1;
        allow delete: if isOwner(likerId)
          && getAfter(checkInPath(checkInId)).data.likeCount
               == get(checkInPath(checkInId)).data.get('likeCount', 0) - 1;
      }
    }
  }
}
