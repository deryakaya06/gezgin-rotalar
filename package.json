{
  "name": "gezgin-rotalar",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "seed:locations": "node scripts/seed-locations.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.5.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.25.0"
  }
}
